# =====================================================================
# app.env.contoh — TEMPLATE konfigurasi (SATU sumber env untuk semua).
#
# CARA PAKAI:
#   1. Salin jadi app.env:   cp app.env.contoh app.env   (Windows: copy)
#   2. Isi nilai di bawah.
#   3. Di server, amankan:   chmod 600 app.env
#
# File app.env (yang sudah berisi rahasia) TIDAK boleh di-commit — sudah di .gitignore.
# Dibaca otomatis oleh aplikasi (dashboard & cron) lewat config_store.py.
# Format: KEY=value, satu per baris, tanpa perlu tanda kutip.
# =====================================================================

# ---- Odoo (wajib) ----
ODOO_URL=https://contoh.odoo.com
ODOO_DB=nama_database
ODOO_USERNAME=bi@contoh.co.id
ODOO_API_KEY=your_api_key

# ---- BigQuery (wajib) ----
BQ_PROJECT=<project-id-bigquery-anda>
BQ_DATASET=<nama-dataset-anda>
BQ_LOCATION=asia-southeast2
# Path file service-account .json (taruh di folder privat, di luar area web):
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# ---- Login dashboard (wajib untuk dashboard web) ----
DASHBOARD_USERNAME=admin
# HASH password (bukan password mentah). Buat dengan:
#   python -c "from werkzeug.security import generate_password_hash as g; print(g('PasswordAnda'))"
DASHBOARD_PASSWORD_HASH=ISI_HASH_PASSWORD
# Kunci penyegel cookie sesi. Buat dengan:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=ISI_SECRET_KEY_ACAK
# Cookie hanya via HTTPS. Set false HANYA untuk tes lokal via http://localhost.
SESSION_COOKIE_SECURE=true

# ---- Endpoint cron (opsional, untuk /api/cron/run) ----
CRON_TOKEN=ISI_TOKEN_PANJANG

# ---- Jadwal penarikan (opsional; untuk tampilan "berikutnya" + install_cron.sh) ----
SCHEDULE_CRON=0 7-19 * * 1-6
SCHEDULE_TZ=Asia/Jakarta
